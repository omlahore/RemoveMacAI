"Download" = "डाउनलोड करें";
"Not Now" = "अभी नहीं";
"RemoveMacAI is up to date." = "RemoveMacAI अप टू डेट है।";
"You have %@, the latest version." = "आपके पास %@ है, जो नया वर्शन है।";
