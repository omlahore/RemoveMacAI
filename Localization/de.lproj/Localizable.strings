"Background item: %@" = "Hintergrundobjekt: %@";
"You see every change first" = "Du siehst jede Änderung zuerst";
"Nothing happens until you review the list and click Apply." = "Es passiert nichts, bis du die Liste prüfst und auf „Anwenden“ klickst.";
"Everything can be undone" = "Alles lässt sich widerrufen";
