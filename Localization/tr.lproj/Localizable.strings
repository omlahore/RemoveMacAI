"Show the status bar" = "Durum çubuğunu göster";
"Shows the number of items and the free space at the bottom of Finder windows." = "Finder pencerelerinin altında öğe sayısını ve boş alanı gösterir.";
"Keep folders above files" = "Klasörleri dosyaların üstünde tut";
